# ===================================================================
# VARIABLES DE ENTORNO - FORMATOS CUENTAS
# ===================================================================

PORT=5000

# Base de Datos MongoDB:
# - En Docker local: mongodb://mongodb:27017/formatos_cuentas
# - En Desarrollo Windows local (sin Docker): mongodb://localhost:27019/formatos_cuentas
# - Opcional para Raspberry Pi (Ahorra ~350MB de RAM usando MongoDB Atlas gratuito):
#   MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/formatos_cuentas?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongodb:27017/formatos_cuentas

# Clave Secreta JWT para autenticación de sesiones
JWT_SECRET=supersecretkey_change_me_in_production

# Google Gemini API Key (para extracción de documentos e IA)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Token del Bot de Telegram (obtenido de @BotFather)
TELEGRAM_BOT_TOKEN=tu_token_de_telegram_aqui

# (Opcional) Chat ID de Telegram del Administrador para recibir alertas y copias de seguridad automáticas
# Puedes obtener tu ID enviando un mensaje a @userinfobot en Telegram
TELEGRAM_ADMIN_CHAT_ID=

# (Opcional) Días de retención de copias de seguridad (por defecto: 14)
RETENTION_DAYS=14

# Salario Mínimo Mensual Legal Vigente (para cálculo automático de IBC)
SMMLV=1423500

# ===================================================================
# ALMACENAMIENTO GOOGLE DRIVE (5 TB)
# ===================================================================
# Credenciales OAuth 2.0 y Refresh Token generados para Google Drive
GOOGLE_DRIVE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=tu_client_secret
GOOGLE_DRIVE_REFRESH_TOKEN=tu_refresh_token_generado
# Entorno de almacenamiento: 'dev' para pruebas locales, 'prod' para producción
GOOGLE_DRIVE_ENV=prod

# ===================================================================
# ALMACENAMIENTO NAS NEXTCLOUD (Secretaría TIC)
# ===================================================================
NEXTCLOUD_URL=https://nube.ejemplo.gov.co
NEXTCLOUD_USER=tu_usuario
NEXTCLOUD_PASSWORD=tu_contrasena_o_app_token
NEXTCLOUD_BASE_PATH=/


